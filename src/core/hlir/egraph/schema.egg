; Typed egglog schema for the shape-aware HLIR canonicalizer.
;
; Rust will emit structural Expr terms plus semantic facts into these
; functions and relations. Canonicalization rules land in later steps.

(datatype DType)
(constructor F32 () DType)
(constructor F16 () DType)
(constructor BF16 () DType)
(constructor F64 () DType)
(constructor I8 () DType)
(constructor I16 () DType)
(constructor I32 () DType)
(constructor I64 () DType)
(constructor U8 () DType)
(constructor U16 () DType)
(constructor U32 () DType)
(constructor U64 () DType)
(constructor Bool () DType)

(datatype Layout)
(constructor Contiguous () Layout)
(constructor Broadcasted () Layout)
(constructor Strided () Layout)

(datatype Shape)
(constructor ShapeCons (i64 Shape) Shape)
(constructor ShapeNil () Shape)

(datatype Axes)
(constructor AxesCons (i64 Axes) Axes)
(constructor AxesNil () Axes)

(datatype ScalarExpr)
(constructor SConst (i64) ScalarExpr)
(constructor SAdd (ScalarExpr ScalarExpr) ScalarExpr)
(constructor SMul (ScalarExpr ScalarExpr) ScalarExpr)
(constructor SNeg (ScalarExpr) ScalarExpr)

(datatype Expr)
(constructor Leaf (i64) Expr)
(constructor Const (ScalarExpr Shape DType) Expr)
(constructor Neg (Expr) Expr)
(constructor Recip (Expr) Expr)
(constructor Exp (Expr) Expr)
(constructor Log (Expr) Expr)
(constructor Sqrt (Expr) Expr)
(constructor Sin (Expr) Expr)
(constructor Cast (Expr DType) Expr)
(constructor Add (Expr Expr) Expr)
(constructor Mul (Expr Expr) Expr)
(constructor Max (Expr Expr) Expr)
(constructor Min (Expr Expr) Expr)
(constructor Reshape (Expr Shape) Expr)
(constructor Permute (Expr Axes) Expr)
(constructor Expand (Expr Shape) Expr)
(constructor Broadcast (Expr Shape) Expr)

; Semantic functions populated by Rust during encoding.
(function shape-of (Expr) Shape :no-merge)
(function dtype-of (Expr) DType :no-merge)
(function layout-of (Expr) Layout :no-merge)
(function scalar-of (Expr) ScalarExpr :no-merge)
(function rank-of (Shape) i64 :no-merge)
(function numel-id-of (Shape) i64 :no-merge)
(function base-of (Expr) Expr :no-merge)
(function coeff-of (Expr) ScalarExpr :no-merge)

; Scalar arena metadata and exact closure facts emitted by Rust.
(function scalar-dtype (ScalarExpr) DType :no-merge)
(function scalar-value-id (ScalarExpr) i64 :no-merge)
(relation scalar-zero (ScalarExpr))
(relation scalar-one (ScalarExpr))
(relation scalar-neg (ScalarExpr ScalarExpr))
(relation scalar-add (ScalarExpr ScalarExpr ScalarExpr))
(relation scalar-mul (ScalarExpr ScalarExpr ScalarExpr))
(relation requires-cast (DType DType))

; Shape/layout legality facts emitted by Rust.
(relation scalar-shape (Shape))
(relation same-shape (Shape Shape))
(relation same-numel (Shape Shape))
(relation reshape-ok (Shape Shape))
(relation broadcast-ok (Shape Shape))
(relation expand-ok (Shape Shape))
(relation permute-ok (Shape Axes Shape))
(relation axes-compose (Axes Axes Axes))
(relation axes-identity (Axes))
(relation unary-pointwise (Expr))
(relation binary-pointwise (Expr))
(relation scalar-expr (Expr))
(relation tensor-expr (Expr))
(relation legal-add-shapes (Shape Shape Shape))
(relation legal-mul-shapes (Shape Shape Shape))
(relation legal-max-shapes (Shape Shape Shape))
(relation legal-min-shapes (Shape Shape Shape))

; Optional gate for non-IEEE inverse identities.
(relation fast-math-enabled ())

; Scalar-tensor canonicalization keeps scalar arithmetic explicit as
; Broadcast(Const([], ...), shape(x)).
(rule ((= e (Add x (Const c s d)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (= dx d))
      ((union e (Add x (Broadcast (Const c s d) sx)))))

(rule ((= e (Add (Const c s d) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (= dx d))
      ((union e (Add x (Broadcast (Const c s d) sx)))))

(rule ((= e (Add x (Const c s ds)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (requires-cast ds dx))
      ((union e (Add x (Broadcast (Cast (Const c s ds) dx) sx)))))

(rule ((= e (Add (Const c s ds) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (requires-cast ds dx))
      ((union e (Add x (Broadcast (Cast (Const c s ds) dx) sx)))))

(rule ((= e (Mul x (Const c s d)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (= dx d))
      ((union e (Mul (Broadcast (Const c s d) sx) x))))

(rule ((= e (Mul (Const c s d) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (= dx d))
      ((union e (Mul (Broadcast (Const c s d) sx) x))))

(rule ((= e (Mul x (Const c s ds)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (requires-cast ds dx))
      ((union e (Mul (Broadcast (Cast (Const c s ds) dx) sx) x))))

(rule ((= e (Mul (Const c s ds) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (requires-cast ds dx))
      ((union e (Mul (Broadcast (Cast (Const c s ds) dx) sx) x))))

; Linear combination analysis: derive base/coeff and combine like terms using
; exact scalar closure facts emitted from Rust.
(rule ((= x (Leaf i))
       (= sx (shape-of x))
       (= dx (dtype-of x))
       (scalar-one one)
       (= (scalar-dtype one) dx))
      ((set (base-of x) x)
       (set (coeff-of x) one)))

(rule ((= e (Mul (Broadcast (Const c s d) sx) x))
       (= x (Leaf i))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x)))
      ((set (base-of e) x)
       (set (coeff-of e) c)))

(rule ((= e (Mul x (Broadcast (Const c s d) sx)))
       (= x (Leaf i))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x)))
      ((set (base-of e) x)
       (set (coeff-of e) c)))

(rule ((= e (Add a b))
       (= (base-of a) base)
       (= (base-of b) base)
       (= ca (coeff-of a))
       (= cb (coeff-of b))
       (scalar-add ca cb csum)
       (= sx (shape-of base))
       (= dx (dtype-of base)))
      ((union e (Mul (Broadcast (Const csum (ShapeNil) dx) sx) base))
       (set (base-of e) base)
       (set (coeff-of e) csum)))

(rule ((= e (Mul (Broadcast (Const c1 s1 d) sx)
                  (Mul (Broadcast (Const c2 s2 d) sx) x)))
       (scalar-shape s1)
       (scalar-shape s2)
       (scalar-mul c1 c2 c3))
      ((union e (Mul (Broadcast (Const c3 s1 d) sx) x))))

(rule ((= e (Mul (Mul (Broadcast (Const c1 s1 d) sx) x)
                  (Broadcast (Const c2 s2 d) sx)))
       (scalar-shape s1)
       (scalar-shape s2)
       (scalar-mul c1 c2 c3))
      ((union e (Mul (Broadcast (Const c3 s1 d) sx) x))))

(rule ((= e (Add (Broadcast (Const c1 s1 d) sx)
                  (Broadcast (Const c2 s2 d) sx)))
       (scalar-shape s1)
       (scalar-shape s2)
       (scalar-add c1 c2 c3))
      ((union e (Broadcast (Const c3 s1 d) sx))))

(rule ((= e (Add (Add x (Broadcast (Const c1 s1 d) sx))
                  (Broadcast (Const c2 s2 d) sx)))
       (scalar-shape s1)
       (scalar-shape s2)
       (scalar-add c1 c2 c3))
      ((union e (Add x (Broadcast (Const c3 s1 d) sx)))))

(rule ((= e (Add (Broadcast (Const c2 s2 d) sx)
                  (Add x (Broadcast (Const c1 s1 d) sx))))
       (scalar-shape s1)
       (scalar-shape s2)
       (scalar-add c1 c2 c3))
      ((union e (Add x (Broadcast (Const c3 s1 d) sx)))))

; Identity and involution rewrites.
(rule ((= e (Add x (Const c s d)))
       (= s (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e x)))

(rule ((= e (Add (Const c s d) x))
       (= s (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e x)))

(rule ((= e (Mul x (Const c s d)))
       (= s (shape-of x))
       (= d (dtype-of x))
       (scalar-one c))
      ((union e x)))

(rule ((= e (Mul (Const c s d) x))
       (= s (shape-of x))
       (= d (dtype-of x))
       (scalar-one c))
      ((union e x)))

(rule ((= e (Mul x (Const c s d)))
       (= s (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e (Const c s d))))

(rule ((= e (Mul (Const c s d) x))
       (= s (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e (Const c s d))))

(rule ((= e (Add x (Broadcast (Const c s d) sx)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e x)))

(rule ((= e (Add (Broadcast (Const c s d) sx) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e x)))

(rule ((= e (Mul x (Broadcast (Const c s d) sx)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x))
       (scalar-one c))
      ((union e x)))

(rule ((= e (Mul (Broadcast (Const c s d) sx) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x))
       (scalar-one c))
      ((union e x)))

(rule ((= e (Mul x (Broadcast (Const c s d) sx)))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e (Broadcast (Const c s d) sx))))

(rule ((= e (Mul (Broadcast (Const c s d) sx) x))
       (scalar-shape s)
       (= sx (shape-of x))
       (= d (dtype-of x))
       (scalar-zero c))
      ((union e (Broadcast (Const c s d) sx))))

(rewrite (Neg (Neg x)) x)
(rewrite (Recip (Recip x)) x)

(rule ((= e (Exp (Log x)))
       (fast-math-enabled))
      ((union e x)))

(rule ((= e (Log (Exp x)))
       (fast-math-enabled))
      ((union e x)))

; View collapse rules guarded by legality facts.
(rule ((= e (Reshape (Reshape x s1) s2))
       (= sx (shape-of x))
       (reshape-ok sx s1)
       (reshape-ok s1 s2))
      ((union e (Reshape x s2))))

(rule ((= e (Permute (Permute x p1) p2))
       (= sx (shape-of x))
       (permute-ok sx p1 s1)
       (permute-ok s1 p2 s2)
       (axes-compose p1 p2 p3)
       (permute-ok sx p3 s2))
      ((union e (Permute x p3))))

(rule ((= e (Expand (Expand x s1) s2))
       (= sx (shape-of x))
       (expand-ok sx s1)
       (expand-ok s1 s2))
      ((union e (Expand x s2))))

(rule ((= e (Broadcast (Broadcast x s1) s2))
       (= sx (shape-of x))
       (broadcast-ok sx s1)
       (broadcast-ok s1 s2))
      ((union e (Broadcast x s2))))

; Unary-through-view motion. Cast participates as an elementwise op and keeps
; view structure explicit rather than rebuilding views in Rust.
(rule ((= e (Neg (Reshape x s)))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Neg x) s))))

(rule ((= e (Recip (Reshape x s)))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Recip x) s))))

(rule ((= e (Exp (Reshape x s)))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Exp x) s))))

(rule ((= e (Log (Reshape x s)))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Log x) s))))

(rule ((= e (Sqrt (Reshape x s)))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Sqrt x) s))))

(rule ((= e (Sin (Reshape x s)))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Sin x) s))))

(rule ((= e (Cast (Reshape x s) d))
       (= sx (shape-of x))
       (reshape-ok sx s))
      ((union e (Reshape (Cast x d) s))))

(rule ((= e (Neg (Permute x p)))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Neg x) p))))

(rule ((= e (Recip (Permute x p)))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Recip x) p))))

(rule ((= e (Exp (Permute x p)))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Exp x) p))))

(rule ((= e (Log (Permute x p)))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Log x) p))))

(rule ((= e (Sqrt (Permute x p)))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Sqrt x) p))))

(rule ((= e (Sin (Permute x p)))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Sin x) p))))

(rule ((= e (Cast (Permute x p) d))
       (= sx (shape-of x))
       (permute-ok sx p sp))
      ((union e (Permute (Cast x d) p))))

(rule ((= e (Neg (Expand x s)))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Neg x) s))))

(rule ((= e (Recip (Expand x s)))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Recip x) s))))

(rule ((= e (Exp (Expand x s)))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Exp x) s))))

(rule ((= e (Log (Expand x s)))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Log x) s))))

(rule ((= e (Sqrt (Expand x s)))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Sqrt x) s))))

(rule ((= e (Sin (Expand x s)))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Sin x) s))))

(rule ((= e (Cast (Expand x s) d))
       (= sx (shape-of x))
       (expand-ok sx s))
      ((union e (Expand (Cast x d) s))))

(rule ((= e (Neg (Broadcast x s)))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Neg x) s))))

(rule ((= e (Recip (Broadcast x s)))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Recip x) s))))

(rule ((= e (Exp (Broadcast x s)))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Exp x) s))))

(rule ((= e (Log (Broadcast x s)))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Log x) s))))

(rule ((= e (Sqrt (Broadcast x s)))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Sqrt x) s))))

(rule ((= e (Sin (Broadcast x s)))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Sin x) s))))

(rule ((= e (Cast (Broadcast x s) d))
       (= sx (shape-of x))
       (broadcast-ok sx s))
      ((union e (Broadcast (Cast x d) s))))

; Binary-through-view motion uses source-shape legality, not just matching view
; outputs, so illegal reshape or broadcast sinking stays blocked by missing facts.
(rule ((= e (Add (Reshape x s) (Reshape y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (reshape-ok sx s)
       (reshape-ok sy s)
       (legal-add-shapes sx sy so)
       (reshape-ok so s))
      ((union e (Reshape (Add x y) s))))

(rule ((= e (Mul (Reshape x s) (Reshape y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (reshape-ok sx s)
       (reshape-ok sy s)
       (legal-mul-shapes sx sy so)
       (reshape-ok so s))
      ((union e (Reshape (Mul x y) s))))

(rule ((= e (Max (Reshape x s) (Reshape y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (reshape-ok sx s)
       (reshape-ok sy s)
       (legal-max-shapes sx sy so)
       (reshape-ok so s))
      ((union e (Reshape (Max x y) s))))

(rule ((= e (Min (Reshape x s) (Reshape y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (reshape-ok sx s)
       (reshape-ok sy s)
       (legal-min-shapes sx sy so)
       (reshape-ok so s))
      ((union e (Reshape (Min x y) s))))

(rule ((= e (Add (Permute x p) (Permute y p)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (permute-ok sx p spx)
       (permute-ok sy p spy)
       (legal-add-shapes spx spy spo)
       (legal-add-shapes sx sy so)
       (permute-ok so p spo))
      ((union e (Permute (Add x y) p))))

(rule ((= e (Mul (Permute x p) (Permute y p)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (permute-ok sx p spx)
       (permute-ok sy p spy)
       (legal-mul-shapes spx spy spo)
       (legal-mul-shapes sx sy so)
       (permute-ok so p spo))
      ((union e (Permute (Mul x y) p))))

(rule ((= e (Max (Permute x p) (Permute y p)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (permute-ok sx p spx)
       (permute-ok sy p spy)
       (legal-max-shapes spx spy spo)
       (legal-max-shapes sx sy so)
       (permute-ok so p spo))
      ((union e (Permute (Max x y) p))))

(rule ((= e (Min (Permute x p) (Permute y p)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (permute-ok sx p spx)
       (permute-ok sy p spy)
       (legal-min-shapes spx spy spo)
       (legal-min-shapes sx sy so)
       (permute-ok so p spo))
      ((union e (Permute (Min x y) p))))

(rule ((= e (Add (Expand x s) (Expand y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (expand-ok sx s)
       (expand-ok sy s)
       (legal-add-shapes sx sy so)
       (expand-ok so s))
      ((union e (Expand (Add x y) s))))

(rule ((= e (Mul (Expand x s) (Expand y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (expand-ok sx s)
       (expand-ok sy s)
       (legal-mul-shapes sx sy so)
       (expand-ok so s))
      ((union e (Expand (Mul x y) s))))

(rule ((= e (Max (Expand x s) (Expand y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (expand-ok sx s)
       (expand-ok sy s)
       (legal-max-shapes sx sy so)
       (expand-ok so s))
      ((union e (Expand (Max x y) s))))

(rule ((= e (Min (Expand x s) (Expand y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (expand-ok sx s)
       (expand-ok sy s)
       (legal-min-shapes sx sy so)
       (expand-ok so s))
      ((union e (Expand (Min x y) s))))

(rule ((= e (Add (Broadcast x s) (Broadcast y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (broadcast-ok sx s)
       (broadcast-ok sy s)
       (legal-add-shapes sx sy so)
       (broadcast-ok so s))
      ((union e (Broadcast (Add x y) s))))

(rule ((= e (Mul (Broadcast x s) (Broadcast y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (broadcast-ok sx s)
       (broadcast-ok sy s)
       (legal-mul-shapes sx sy so)
       (broadcast-ok so s))
      ((union e (Broadcast (Mul x y) s))))

(rule ((= e (Max (Broadcast x s) (Broadcast y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (broadcast-ok sx s)
       (broadcast-ok sy s)
       (legal-max-shapes sx sy so)
       (broadcast-ok so s))
      ((union e (Broadcast (Max x y) s))))

(rule ((= e (Min (Broadcast x s) (Broadcast y s)))
       (= sx (shape-of x))
       (= sy (shape-of y))
       (broadcast-ok sx s)
       (broadcast-ok sy s)
       (legal-min-shapes sx sy so)
       (broadcast-ok so s))
      ((union e (Broadcast (Min x y) s))))

; Commutative/associative equalities for extraction-time canonical ordering.
; The cost model chooses the stable sorted, right-associated representative.
(ruleset canonical-order)
(rewrite (Add x y) (Add y x) :ruleset canonical-order)
(rewrite (Mul x y) (Mul y x) :ruleset canonical-order)
(rewrite (Add (Add x y) z) (Add x (Add y z)) :ruleset canonical-order)
(rewrite (Mul (Mul x y) z) (Mul x (Mul y z)) :ruleset canonical-order)
